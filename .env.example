# Django
DEBUG=false
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-new-one-for-production
ALLOWED_HOSTS=your-app-name.onrender.com,www.your-app-name.onrender.com

# Database (Render will provide this automatically via DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Two-Factor Auth (optional)
TWO_FACTOR_PATCH_ADMIN=true

# Email (for production notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
